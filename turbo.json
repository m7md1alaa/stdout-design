{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "@stdout-design/core#build": {
      "inputs": ["src/**", "tsdown.config.ts", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "@stdout-design/core#dev": {
      "cache": false,
      "persistent": true
    },
    "@stdout-design/dev-server#build": {
      "inputs": ["src/**", "tsdown.config.ts", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "@stdout-design/dev-server#dev": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
