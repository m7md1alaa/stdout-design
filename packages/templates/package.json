{
  "name": "@stdout-design/templates",
  "version": "0.3.2",
  "description": "Ready-to-use Takumi-compatible templates for stdout-design — OG images, social cards, and more",
  "keywords": [
    "design",
    "image-generation",
    "og",
    "social-media",
    "templates",
    "tsx"
  ],
  "homepage": "https://github.com/m7md1alaa/stdout-design#readme",
  "bugs": {
    "url": "https://github.com/m7md1alaa/stdout-design/issues"
  },
  "license": "MIT",
  "author": "Mohammed alaa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m7md1alaa/stdout-design.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "check-types:tsgo": "tsgo --noEmit",
    "lint": "ultracite check"
  },
  "devDependencies": {
    "@stdout-design/config": "workspace:*",
    "@types/react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  }
}
