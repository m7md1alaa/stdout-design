{
  "name": "@stdout-design/core",
  "version": "0.1.1",
  "description": "Core rendering engine for stdout-design — compile TSX templates to pixel-perfect images via Takumi",
  "keywords": [
    "design",
    "image-generation",
    "rendering",
    "social-media",
    "takumi",
    "tsx"
  ],
  "homepage": "https://github.com/m7md1alaa/stdout-design#readme",
  "bugs": {
    "url": "https://github.com/m7md1alaa/stdout-design/issues"
  },
  "license": "MIT",
  "author": "Mohammed alaa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m7md1alaa/stdout-design.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./schema": {
      "development": {
        "import": "./src/schema.ts",
        "types": "./src/schema.ts"
      },
      "import": "./dist/schema.mjs",
      "types": "./dist/schema.d.mts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test",
    "test:integration": "bun test ./src/__tests__/full-pipeline.integration.ts",
    "check-types": "tsc --noEmit",
    "check-types:tsgo": "tsgo --noEmit",
    "lint": "ultracite check"
  },
  "dependencies": {
    "@takumi-rs/core": "^2.1.1",
    "@takumi-rs/helpers": "^2.1.1",
    "csv-parse": "^7.0.1",
    "kysely": "^0.29.3",
    "kysely-bun-sqlite": "^0.4.0",
    "p-limit": "^7.3.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.7",
    "takumi-js": "^2.1.1",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "^15.4.0",
    "@stdout-design/config": "workspace:*",
    "@takumi-rs/wasm": "^2.1.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.17",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "@types/write-file-atomic": "^4.0.3",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2"
  }
}
