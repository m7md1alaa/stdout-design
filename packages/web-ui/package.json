  },
  "license": "MIT",
  "author": "Mohammed alaa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m7md1alaa/stdout-design.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check-types": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json",
    "check-types:tsgo": "tsgo --noEmit",
    "lint": "ultracite check",
    "preview": "vite preview",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
