{
  "name": "@stdout-design/web-ui",
  "version": "0.7.1",
  "description": "Vite + React preview UI for stdout-design — live template editing, prop panels, and canvas preview",
  "keywords": [
    "design",
    "image-generation",
    "live-preview",
    "react",
    "social-media",
    "studio",
    "ui",
    "vite"
  ],
  "homepage": "https://github.com/m7md1alaa/stdout-design#readme",
