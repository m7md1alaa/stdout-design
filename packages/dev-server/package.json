{
  "name": "@stdout-design/dev-server",
  "version": "0.6.0",
  "description": "Hono-based dev server for stdout-design — live preview, hot reload, and template rendering API",
  "keywords": [
    "design",
    "dev-server",
    "hono",
    "image-generation",
    "live-preview",
    "social-media",
    "studio"
  ],
  "homepage": "https://github.com/m7md1alaa/stdout-design#readme",
  "bugs": {
    "url": "https://github.com/m7md1alaa/stdout-design/issues"
  },
  "license": "MIT",
  "author": "Mohammed alaa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m7md1alaa/stdout-design.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./serve": {
      "import": "./dist/serve.mjs",
      "types": "./dist/serve.d.mts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "serve": "bun src/serve.ts",
    "check-types": "tsc --noEmit",
    "check-types:tsgo": "tsgo --noEmit",
    "test": "bun test",
    "test:integration": "bun test ./src/__tests__/hot-reload.integration.ts",
    "lint": "ultracite check"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@stdout-design/core": "^0.6.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chokidar": "^6.0.0",
    "hono": "^4.13.13",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0"
  },
  "devDependencies": {
    "@stdout-design/config": "workspace:*",
    "tsdown": "^0.23.2",
    "typescript": "7.1.0-beta"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.22"
  }
}
