{
  "name": "@stdout-design/cli",
  "version": "0.3.2",
  "description": "stdout-design CLI — shallow front door to @stdout-design/core and @stdout-design/dev-server",
  "keywords": [
    "cli",
    "design",
    "image-generation",
    "social-media",
    "takumi",
    "tsx"
  ],
  "homepage": "https://github.com/m7md1alaa/stdout-design#readme",
  "bugs": {
    "url": "https://github.com/m7md1alaa/stdout-design/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m7md1alaa/stdout-design/studio.git"
  },
  "bin": {
    "studio": "dist/index.mjs"
  },
  "files": [
    "dist",
    "template"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./schema": {
      "import": "./dist/schema.mjs",
      "types": "./dist/schema.d.mts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "lint": "ultracite check",
    "test": "bun test 2>/dev/null || true"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@stdout-design/core": "workspace:*",
    "commander": "^15.0.0",
    "package-manager-detector": "^1.8.0"
  },
  "devDependencies": {
    "@stdout-design/config": "workspace:*",
    "@stdout-design/dev-server": "workspace:*",
    "@stdout-design/web-ui": "workspace:*",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  }
}
