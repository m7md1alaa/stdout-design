{
  "name": "@stdout-design/cli",
  "version": "0.1.2",
  "description": "stdout-design CLI — shallow front door to @stdout-design/core and @stdout-design/dev-server",
  "keywords": [
    "cli",
    "design",
    "image-generation",
    "social-media",
    "takumi",
    "tsx"
  ],
  "homepage": "https://github.com/m7md1alaa/stdout-design#readme",
  "bugs": {
    "url": "https://github.com/m7md1alaa/stdout-design/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m7md1alaa/stdout-design/studio.git"
  },
  "bin": {
    "studio": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./schema": {
      "development": {
        "import": "./src/schema.ts",
        "types": "./src/schema.ts"
      },
      "import": "./dist/schema.mjs",
      "types": "./dist/schema.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "lint": "ultracite check",
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@stdout-design/core": "^0.1.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@stdout-design/config": "workspace:*",
    "tsdown": "^0.22.4",
    "typescript": "^7"
  },
  "peerDependencies": {
    "@stdout-design/dev-server": "^0.1.1",
    "@stdout-design/web-ui": "^0.1.1"
  },
  "peerDependenciesMeta": {
    "@stdout-design/dev-server": {
      "optional": true
    },
    "@stdout-design/web-ui": {
      "optional": true
    }
  }
}
