{
  "name": "@stdout-design/cli",
  "version": "0.0.0",
  "description": "stdout-design CLI — shallow front door to @stdout-design/core and @stdout-design/dev-server",
  "keywords": [
    "cli",
    "design",
    "image-generation",
    "social-media",
    "takumi",
    "tsx"
  ],
  "homepage": "https://github.com/stdout/studio#readme",
  "bugs": {
    "url": "https://github.com/stdout/studio/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stdout/studio.git"
  },
  "bin": {
    "studio": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./schema": {
      "development": {
        "import": "./src/schema.ts",
        "types": "./src/schema.ts"
      },
      "import": "./dist/schema.mjs",
      "types": "./dist/schema.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "lint": "ultracite check",
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@takumi-rs/core": "^2.0.0",
    "@takumi-rs/helpers": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.1",
    "hono": "^4.12.26",
    "kysely": "^0.29.3",
    "kysely-bun-sqlite": "^0.4.0",
    "ora": "^9.4.1",
    "p-limit": "^7.0.0",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.7",
    "takumi-js": "^2.0.0",
    "vite": "^8.0.12",
    "vite-node": "^6.0.0",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stdout-design/config": "workspace:*",
    "@stdout-design/core": "workspace:*",
    "@stdout-design/dev-server": "workspace:*",
    "@types/react": "19.2.17",
    "tsdown": "^0.22.4",
    "typescript": "^7"
  }
}
