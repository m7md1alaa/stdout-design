{
  "name": "stdout-design",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev serve",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "check-types:tsgo": "turbo check-types:tsgo",
    "check": "ultracite check && bun knip",
    "knip": "knip",
    "fix": "ultracite fix",
    "version:sync": "bun scripts/version-sync.ts",
    "publish:all": "turbo build && npm publish -w packages/core && npm publish -w packages/dev-server && npm publish -w packages/cli && npm publish -w packages/web-ui"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stdout-design/config": "workspace:*",
    "@stdout-design/core": "workspace:*",
    "@stdout-design/dev-server": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "knip": "^6.29.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "turbo": "^2.10.6",
    "typescript": "^7.0.2",
    "ultracite": "^7.9.4"
  },
  "packageManager": "bun@1.3.13",
  "catalog": {
    "react": "19.2.7",
    "vite": "^8.0.12",
    "react-dom": "19.2.7",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "^7",
    "zod": "^4.4.3",
    "tsdown": "^0.22.4"
  }
}
